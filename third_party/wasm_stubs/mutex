// Stub <mutex> for single-threaded WASM. No-op locks (no contention possible).
#pragma once
#ifndef _WASM_STUB_MUTEX
#define _WASM_STUB_MUTEX

// Prevent libc++'s <mutex> from loading (it requires pthreads)
#ifndef _LIBCPP_MUTEX
#define _LIBCPP_MUTEX
#endif

namespace std {

struct mutex {
    constexpr mutex() noexcept = default;
    ~mutex() = default;
    mutex(const mutex&) = delete;
    mutex& operator=(const mutex&) = delete;
    void lock() {}
    void unlock() {}
    bool try_lock() { return true; }
};

struct recursive_mutex {
    constexpr recursive_mutex() = default;
    ~recursive_mutex() = default;
    recursive_mutex(const recursive_mutex&) = delete;
    recursive_mutex& operator=(const recursive_mutex&) = delete;
    void lock() {}
    void unlock() {}
    bool try_lock() { return true; }
};

struct adopt_lock_t { explicit adopt_lock_t() = default; };
struct defer_lock_t { explicit defer_lock_t() = default; };
struct try_to_lock_t { explicit try_to_lock_t() = default; };

template<class M>
class lock_guard {
public:
    using mutex_type = M;
    explicit lock_guard(M&) {}
    lock_guard(M&, adopt_lock_t) {}
    ~lock_guard() = default;
    lock_guard(const lock_guard&) = delete;
    lock_guard& operator=(const lock_guard&) = delete;
};

template<class M>
class unique_lock {
public:
    using mutex_type = M;
    unique_lock() noexcept : m_(nullptr), owns_(false) {}
    explicit unique_lock(M& m) : m_(&m), owns_(true) {}
    unique_lock(unique_lock&& o) noexcept : m_(o.m_), owns_(o.owns_) { o.m_ = nullptr; o.owns_ = false; }
    ~unique_lock() = default;
    unique_lock& operator=(unique_lock&& o) noexcept { m_ = o.m_; owns_ = o.owns_; o.m_ = nullptr; o.owns_ = false; return *this; }
    void lock() { owns_ = true; }
    void unlock() { owns_ = false; }
    bool owns_lock() const noexcept { return owns_; }
    M* mutex() const noexcept { return m_; }
private:
    M* m_;
    bool owns_;
};

#ifndef _LIBCPP___MUTEX_ONCE_FLAG_H
#define _LIBCPP___MUTEX_ONCE_FLAG_H
struct once_flag {
    constexpr once_flag() noexcept : _called(false) {}
    once_flag(const once_flag&) = delete;
    once_flag& operator=(const once_flag&) = delete;
    bool _called;
};

template<class F, class... Args>
void call_once(once_flag& flag, F&& f, Args&&... args) {
    if (!flag._called) {
        flag._called = true;
        f(static_cast<Args&&>(args)...);
    }
}
#endif

} // namespace std

#endif // _WASM_STUB_MUTEX
